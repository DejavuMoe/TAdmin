# Copy to .env.laya; keep the real key out of Git. This is Compose interpolation,
# separate from tadmin.env. Set the same local key on both services via Compose.
LAYA_API_KEY=
LAYA_PLATFORM=linux/arm64
# Laya 0.4.10 source, pinned to the upstream release commit.
LAYA_BUILD_CONTEXT=https://github.com/NandhaKishorM/laya.git#a4958de6ad4fc816624a3862cd5a57f929be98c8
LAYA_IMAGE=tadmin-laya:0.4.10
# Standalone convaiinnovations/laya-multilingual snapshot; not the bundled repo.
LAYA_REVISION=1720e3e3357cfe1e281542e223f8273b0890ca34
LAYA_THREADS=3
LAYA_MAX_CONCURRENT=2
LAYA_CPUS=3
LAYA_MEMORY=8g
