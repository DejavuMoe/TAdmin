# Keep LF in the repository and in every checkout: the tree is built on Linux
# (Docker, WSL mirror) and generated docs data is compared byte-for-byte.
* text=auto eol=lf
*.png binary
*.ico binary
# Frozen evaluation data uses byte hashes; preserve its original line endings.
/deploy/laya/eval/*.json -text
/deploy/laya/eval/*.jsonl -text
/docs/diagnostics/*.json -text
