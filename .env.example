# Docker Compose interpolation only; bot credentials belong in tadmin.env.
# First trial: build this checkout locally. No published release is assumed.
TADMIN_IMAGE=tadmin:local
TADMIN_VERSION=dev
TADMIN_HTTP_PORT=8080
# After a release exists, use its immutable tag or digest, for example:
# TADMIN_IMAGE=ghcr.io/dejavumoe/tadmin:v2.0.0
# TADMIN_VERSION=v2.0.0
