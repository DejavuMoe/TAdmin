# ===== 必填 =====
# 从 @BotFather 获取；切勿提交到 Git
TADMIN_BOT_TOKEN=
# 你的 Telegram 数字 ID（可向 @userinfobot 查询）
TADMIN_OWNER_ID=

# ===== 可选 =====
# 时区（统计按此划分日期）
TADMIN_TIMEZONE=Asia/Shanghai
# 默认语言：zh-CN / en
# TADMIN_LANGUAGE=zh-CN
# Mini App 大图验证与 Guard 零窗口入群：填写反向代理后的 HTTPS 源
# TADMIN_PUBLIC_URL=https://verify.example.com
# 预览刷新用户号：在 https://my.telegram.org 申请
# TADMIN_API_ID=
# TADMIN_API_HASH=
# AI 入群资料风险提示（TypeSafe Jev）
# TADMIN_TYPESAFE_API_KEY=
# 默认 jev；当前试用逐群选“仅提示”。Laya 已暂停，以下仅保留实验配置。
# TADMIN_TYPESAFE_PROVIDER=jev
# TADMIN_TYPESAFE_BASE_URL=https://api.typesafe.ai
# TADMIN_TYPESAFE_MODEL=jev-latest
# Laya 示例（不使用 Compose 覆盖文件时）：
# TADMIN_TYPESAFE_PROVIDER=laya
# TADMIN_TYPESAFE_BASE_URL=http://laya:8000
# TADMIN_TYPESAFE_MODEL=convaiinnovations/laya-multilingual
# TADMIN_TYPESAFE_API_KEY=<自部署服务的本地密钥>
